# --- WeLockin backend environment ---

# MongoDB connection string. Prisma's MongoDB provider requires a replica set;
# MongoDB Atlas (mongodb+srv) provides one by default. Include the database name.
# REQUIRED in production — the server refuses to boot without it (no localhost fallback).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/welockin?retryWrites=true&w=majority"

# Secret used to sign JWTs — use a long random string. REQUIRED in production: the
# server refuses to boot if this is unset or left at "change-me" (a guessable
# secret would let anyone forge a valid token).
JWT_SECRET="change-me"

# How long issued tokens stay valid (e.g. 30d, 12h, 3600). Optional; defaults to 30d.
JWT_EXPIRES_IN="30d"

# HTTP port the server listens on.
PORT=8787

# CORS allow-list. Use * to allow any origin, or a comma-separated list of origins.
CORS_ORIGIN=*

# Sign in with Apple: the iOS app bundle id the identityToken's `aud` must match.
# Used by POST /api/auth/apple to verify tokens. Must match the iOS app bundle id
# (same base as APP_ATTEST_APP_ID below).
APPLE_BUNDLE_ID="in.welock.app"

# --- Admin console (POST /api/admin/login) ---
# Credentials the admin web app authenticates with. Set a strong password in
# production. Admin login is DISABLED while ADMIN_PASSWORD is empty.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Separate signing secret for admin tokens (falls back to JWT_SECRET if unset).
ADMIN_JWT_SECRET="change-me-too"
# How long an admin session token stays valid. Optional; defaults to 12h.
ADMIN_JWT_EXPIRES_IN="12h"

# A live session with no heartbeat for longer than this (seconds) is treated as
# ended. Default 660 = two missed 5-min beats + grace.
LIVE_SESSION_STALE_SECONDS=660

# --- App Attest (iOS focus-report integrity) ---
# Hard-enforce App Attest on counter-crediting routes (focus-events, breaks).
# Keep false until the native attestation client ships and is device-tested —
# turning it on before then rejects ALL focus reporting.
ATTEST_REQUIRED=false
# App Attest environment the client attests against: "development" for
# TestFlight/dev builds, "production" for App Store builds.
APP_ATTEST_ENV="production"
# App Attest app identifier = "<AppleTeamID>.<iOSBundleID>".
APP_ATTEST_APP_ID="YF7AFPJRYH.in.welock.app"

# --- Resend (transactional email) ---
# API key from resend.com (starts with re_). Email is a no-op while empty.
#
# NOT optional once email verification is enforced: an empty key makes every send
# a LOGGED NO-OP, so signup appears to work and mails nobody — which, with
# verification required, is every new user locked out with no code coming.
RESEND_API_KEY=""
# Verified sender for every transactional email: the partner OTP, the signup
# verification code and the password-reset link. The DOMAIN must be verified in
# your Resend account.
# For a quick test you can use: "WeLockin <onboarding@resend.dev>"
RESEND_FROM="WeLockin <protection@welock.in>"

# --- Email verification + password reset ---
#
# Base URL of the marketing site, used to build the emailed reset link. Set it to
# the real site: the link is NEVER built from the request's Host header, because
# behind a proxy that header is attacker-controlled and this is the one email you
# do not want pointed at a host of someone else's choosing.
# Note the www — the apex 308-redirects to it.
PUBLIC_SITE_URL="https://www.welock.in"
# Server-only HMAC key for verification codes and reset tokens. Derived from
# JWT_SECRET when empty. UNLIKE TRIAL_LEDGER_PEPPER, rotating this is harmless:
# it only invalidates the codes currently in flight, which expire in minutes.
AUTH_TOKEN_PEPPER=""
EMAIL_VERIFICATION_TTL_MINUTES="10"
EMAIL_VERIFICATION_MAX_ATTEMPTS="5"
PASSWORD_RESET_TTL_MINUTES="60"
#
# May the API REFUSE an unverified account (403 EMAIL_NOT_VERIFIED)?
#
# Leave "false" until BOTH are true:
#   1. `npm run auth:migrate -- --apply` has run, grandfathering every account
#      created before verification existed. Without it, turning this on locks out
#      the entire existing user base at once — none of them have a code.
#   2. Every client (Windows, macOS, mobile) can render a code screen in response
#      to the 403. A client that cannot just shows an error nobody can act on.
EMAIL_VERIFICATION_ENFORCED="false"
#
# May registration be REFUSED because this machine already belongs to another
# account (409 DEVICE_ALREADY_CLAIMED)?
#
# Independent of the anti-farm guarantee, which needs no flag: a second account on
# a claimed machine shares the existing claim and gets no second trial either way.
# This only controls the hard refusal, whose false positives are real people on
# shared, resold or reimaged computers — hence an off switch that works without a
# deploy. Run with "false" first and read the logs before turning it on.
DEVICE_BINDING_ENFORCED="false"
# TESTS ONLY. Requires the literal string "true".
AUTH_RATE_LIMIT_DISABLED=""

# --- Lemon Squeezy (desktop: macOS + Windows) ---
#
# ALL FOUR OR NONE. Leaving every value empty is a legitimate state — the deploy
# simply cannot sell and POST /api/checkout answers 400. Setting only SOME of them
# switches purchasing OFF with a loud [env] error, on purpose: with an api key but
# no webhook secret the payment page mints fine and every delivery coming back is
# rejected as unsigned, so the customer is charged and no licence is ever granted.
# (Outside production the same mistake throws at boot instead, where that costs a
# restart rather than an outage.)
#
# Webhook URL to register in the dashboard:
#   https://<your-domain>/api/webhooks/lemonsqueezy
# Events: order_created, order_refunded, plus the twelve subscription_* events
# (SUBSCRIPTION_EVENTS in src/lib/lemonsqueezy.ts is the authoritative list —
# in the dashboard, simply ticking every order_* and subscription_* box is right).
#
# API key from lemonsqueezy.com → Settings → API. TEST vs LIVE is decided by
# WHICH KEY this is — a test key can only ever create test checkouts.
# (LEMON_API_KEY is accepted as an alias — it is what production has carried
# since the first integration.)
LEMONSQUEEZY_API_KEY=""
# Signing secret you chose when creating the webhook. Signature verification
# fails CLOSED while this is empty: every delivery is rejected.
LEMONSQUEEZY_WEBHOOK_SECRET=""
# Your store id (Settings → Stores). Not a secret — it rides in every webhook
# delivery — but load-bearing: isSellableOrder refuses orders from any other
# store, so a wrong value here refuses every real sale.
#
# EMPTY like the other three ON PURPOSE, even though the real value never
# changes: this template used to pre-fill the two ids while leaving key and
# secret blank, which is a PARTIAL config — the exact state the all-or-none rule
# exists to refuse — so the README's own `cp .env.example .env && npm run dev`
# bootstrap threw at boot. All four empty boots fine and simply cannot sell.
LEMONSQUEEZY_STORE_ID=""
# The lifetime variant (74,99 €). Unset means "sell no lifetime licence", never
# "sell everything": a signature only proves the delivery came from our store,
# not that the buyer bought this. NOTE: ids DIFFER between test and live mode,
# which is why nothing here is defaulted — copy them from the dashboard in the
# mode your API key belongs to, then confirm with GET /api/health/lemonsqueezy,
# which lists every variant the configured key can actually see.
# (LEMONSQUEEZY_VARIANT_LIFETIME is accepted as an alias.)
LEMONSQUEEZY_VARIANT_ID=""
# Override only for tests.
LEMONSQUEEZY_API_BASE="https://api.lemonsqueezy.com"
# May a TEST-mode order grant a real lifetime licence? Requires the literal
# "true", and deliberately NOT inferred from NODE_ENV — which is unset on more
# machines than anyone expects, and every one of those would have failed OPEN
# into a free-licence tap. Prefer separate test/live webhooks over this flag.
LEMONSQUEEZY_ALLOW_TEST_MODE="false"

# --- RevenueCat (iOS: StoreKit subscriptions + lifetime) ---
#
# BOTH OR NEITHER. The webhook token is what lets a delivery be believed, and the
# secret API key is what lets us re-fetch the subscriber that delivery describes
# — every webhook ends in a re-fetch, so either half alone is a feature that
# cannot work and is treated as OFF (with a loud [env] warning).
#
# Webhook URL to register in the RevenueCat dashboard:
#   https://<your-domain>/api/webhooks/revenuecat
# Set the dashboard's "Authorization header value" to the SAME long random string
# as here. RevenueCat does not sign deliveries; this header is the perimeter.
REVENUECAT_WEBHOOK_AUTH_TOKEN=""
# Secret API key (dashboard -> API keys -> secret). Used server-side for
# GET /v1/subscribers/{app_user_id}. NEVER the public SDK key.
REVENUECAT_SECRET_API_KEY=""
# OPTIONAL second factor: when set, deliveries must also carry a valid
# X-RevenueCat-Signature (hex HMAC-SHA256 of the raw body). RevenueCat does not
# sign webhooks natively today — this is for a signing proxy in front of us.
# Verified only while set; the Authorization token stays the real barrier.
REVENUECAT_WEBHOOK_HMAC_SECRET=""
# Informational: the RevenueCat project this deploy serves.
REVENUECAT_PROJECT_ID=""
# The entitlement identifier configured in RevenueCat. Informative only — access
# is decided from our own mirrored Subscription/Purchase rows, never from this.
REVENUECAT_EXPECTED_ENTITLEMENT="pro"
# OPTIONAL allow-list of RevenueCat app ids (comma-separated). When set, webhook
# events for any other app are acknowledged and skipped.
REVENUECAT_ALLOWED_APP_IDS=""
# May a SANDBOX (TestFlight / Xcode) transaction grant real access? Requires the
# literal "true". Sandbox events are always RECORDED (rows carry testMode) —
# this only decides whether those rows GRANT, so flipping it needs no migration.
#
# LEAVE THIS "false" ON THE PRODUCTION DEPLOY, and note why the usual advice
# ("true on staging") does not apply here: there IS no staging. This project is
# a single Vercel deployment against a single Atlas database (see README →
# Deployment), so the flag is not "let the testers in" — it is "let ANY Apple ID
# in the world mint free lifetimes against the production database". A StoreKit
# sandbox purchase costs nothing and is signed by the same Apple chain as a real
# one; this gate is the only thing between the two.
REVENUECAT_ALLOW_SANDBOX="false"
# The narrow form of the switch above: WHICH accounts may have their sandbox
# rows granted, as a comma-separated list of our own user ids (24-hex Mongo
# ObjectIds — copy them from the admin console, they are not emails).
#
# This is how a TestFlight tester is given access on a deploy with no staging
# environment. Everything else is unchanged: sandbox rows are still recorded for
# everyone, this still only decides whether they are READ, and emptying the list
# hides them again without deleting a thing. Entries that are not account ids
# are dropped with a warning at boot. REVENUECAT_ALLOW_SANDBOX="true" outranks
# the list, for the day a real staging deploy exists.
REVENUECAT_SANDBOX_ALLOWED_USER_IDS=""
# Webhook events older than this many hours are acknowledged and skipped as
# replays. RevenueCat retries deliveries for up to ~72h — 96 leaves headroom.
REVENUECAT_MAX_EVENT_AGE_HOURS="96"

# --- The trial ledger (one free trial per MACHINE) ---
#
# Server-only HMAC key for the device hashes in TrialClaim. KEYED, not a plain
# digest, because a macOS IOPlatformUUID is a low-entropy value in a known format
# — a plain SHA-256 of it is a lookup table, not a one-way function. This key
# never goes in the database, so a copy of Mongo alone cannot be walked back to
# the machines it describes.
#
# Optional, but SET IT. Left empty, one is derived from JWT_SECRET — which means
# rotating JWT_SECRET (a thing you would otherwise do freely) silently orphans
# every claim and re-opens the trial farm. An explicit pepper decouples the two.
# Rotating THIS value has the same effect: treat it as permanent.
TRIAL_LEDGER_PEPPER=""

# May SIGNING UP still mint a free CARDLESS trial?
#
# "false" is the current product: a plan is chosen at the paywall and the trial
# that comes with it is card-backed (3 days monthly / 7 days yearly, via Lemon
# Squeezy). An account that also got 14 free days on signup would never have to
# choose one, so the paywall would gate nothing.
#
# Only MINTING is off. A claim that already exists is still honoured, so nobody
# mid-trial loses the days they were promised — they meet the paywall when their
# window ends, like everyone else.
SIGNUP_TRIAL_ENABLED="false"

# Trial length in days, for the cardless window above. Snapshotted onto each
# claim, so changing it never moves the end date of a window someone is inside.
TRIAL_DAYS="14"
# The shorter window for a machine whose identity is RESETTABLE — a Mac whose
# IOPlatformUUID could not be read, so the client fell back to a file the user
# can delete. Without this, "break the hardware lookup" is the bypass.
TRIAL_DAYS_UNVERIFIED="3"

# --- Entitlement rollout ---
#
# Whether clients may HARD-GATE on the entitlement they are told. The server
# always reports the true status; this only says whether the client may act on it.
#
# Keep it false until you have (a) a usable storefront — `true` without one is
# forced back off, because a paywall nobody can pay through would lock out every
# expired account with no way out — and (b) grandfathered the existing cohort.
# The day this flips, every account whose trial quietly elapsed months ago
# becomes `expired` at once.
ENTITLEMENT_ENFORCED="false"

# --- Purchase providers (see src/lib/purchase-providers.ts) ---
#
# WHICH SHOPS ARE OPEN. A provider that is off cannot RECORD a new purchase;
# rows it already wrote keep granting, because turning a provider off must never
# retroactively revoke someone who genuinely paid.
#
# Apple stays off until an iOS build ships. The route behind it verifies a
# StoreKit JWS, and a SANDBOX transaction is signed by the same Apple chain as a
# real one — free, and indistinguishable from a purchase to every check except
# the environment field below. A door nobody uses should not be open.
#
# ⭐ TO WIRE iOS IN: set this to "true" and make APPLE_ENVIRONMENT match the build
# ("Sandbox" for TestFlight, "Production" for the App Store). Nothing else
# changes — the route already checks the signature, the chain, the bundle id, the
# product id and the environment.
APPLE_PURCHASES_ENABLED="false"
# Which StoreKit environment a purchase must come from.
APPLE_ENVIRONMENT="Production"

# --- Entitlement receipts (see src/lib/entitlement-receipt.ts) ---
#
# Ed25519 private key, PEM or that PEM base64-encoded. Mint one with:
#   node scripts/gen-entitlement-key.mjs
#
# WHY IT EXISTS. The desktop app works offline by design, so the paywall has to
# survive the network being gone — which means caching a verdict. A verdict
# cached as plain JSON is defeated by one UPDATE in any SQLite browser: ten
# seconds, no skill. Signing it is what makes the cache worth writing.
#
# Empty is legitimate: no key means no receipts, and clients fall back to the
# unsigned fields they already read. That is what lets this ship before every
# client understands it.
#
# Treat it like the updater key. Losing it costs no data, but replacing it stops
# every receipt in the field from verifying, so each machine is locked until it
# can next reach the server.
ENTITLEMENT_SIGNING_KEY=""

# --- Subscriptions (monthly 4,99 € / yearly 19,99 €) ---
#
# These do two unrelated jobs, and the difference matters:
#
#   1. POST /api/checkout maps a plan NAME to one of these ids. That mapping is
#      the security boundary of the endpoint — the client asks for "monthly" and
#      can never ask for a variant of its choosing, so an empty value here means
#      that one plan answers 400 while the other two keep selling.
#   2. The webhook uses them to LABEL a row "monthly" or "yearly" for humans.
#      Never to decide whether a subscription grants access — that is the
#      status's job. So an unrecognised variant degrades to an unlabelled row
#      rather than a refused customer: the day a price changes, someone paying
#      us must not lose access because the id here is one release behind.
#
# These are the NUMERIC variant ids from the variant's edit page — NOT the uuid
# in a /checkout/buy/<uuid> share link, which is a different value entirely.
# Like VARIANT_ID above they differ between test and live mode; confirm with
# GET /api/health/lemonsqueezy after setting them.
LEMONSQUEEZY_VARIANT_MONTHLY=""
LEMONSQUEEZY_VARIANT_YEARLY=""

