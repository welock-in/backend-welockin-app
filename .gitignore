node_modules
dist
.env
.vercel

# Prisma generated client (regenerated via `prisma generate`)
# Keep the schema tracked; the generated client is not.

# Logs & OS cruft
*.log
.DS_Store
Thumbs.db

# Pulled env files. `vercel env pull` writes REAL production secrets into
# .env.prod-pull, which matched none of the rules above — untracked, but not
# ignored, so one `git add -A` away from being committed. `.env` alone was
# never enough. The example file stays tracked: it holds names, not values.
.env.*
!.env.example
