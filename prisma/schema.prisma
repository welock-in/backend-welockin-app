// WeLockin backend — Prisma schema (MongoDB provider).
//
// NOTE: Prisma's MongoDB connector requires a replica set. MongoDB Atlas
// provisions one by default (even on the free M0 tier), so no extra setup is
// needed there. A bare local `mongod` will NOT work unless started as a
// replica set.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev. The rhel targets cover the Vercel/AWS Lambda
  // runtime: Node 20+ (Amazon Linux 2023) uses openssl-3.0.x, Node 18
  // (Amazon Linux 2) uses openssl-1.0.x. Bundling both means the client works
  // regardless of the Node version Vercel picks.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  // Apple supplies a verified real or private-relay email on first consent.
  // Keeping this required preserves the existing PC contract and avoids the
  // single-null limitation of a MongoDB unique index.
  email         String    @unique
  passwordHash  String?
  // Password registrations are unverified until an email-verification flow is
  // completed. Apple users are created with a verified token email.
  emailVerified Boolean?  @default(false)
  plan          String    @default("trial")
  /// LEGACY, read-only. Every account created before the TrialClaim ledger
  /// carries the 14-day window that `POST /api/auth/register` used to stamp.
  /// Nothing writes it any more: a trial now belongs to a MACHINE, not to an
  /// account, because an account costs nothing to make and a machine does not.
  /// The resolver still reads it, so no existing user loses the window they are
  /// inside — but a new account never gets one from here.
  trialEndsAt   DateTime?

  // --- Entitlement overrides & cache -----------------------------------------
  // ALL OPTIONAL, like every column added after launch: on MongoDB `@default` is
  // a create-time default only and `db push` never rewrites existing documents,
  // so a REQUIRED field would make Prisma throw on every legacy user.
  //
  // The comp/revoke pair are AUTHORITATIVE INPUTS to the resolver. The three
  // cache columns are a mirror of what it computed, for the admin console and
  // for `GET /api/me` — never read back for gating, because a stale cache that
  // decides access is a bug that only shows up in production.
  entitlementStatus    String? // "trialing"|"active"|"expired"|"refunded"|"comped"|"revoked"
  isProCached          Boolean?  @default(false)
  entitlementUpdatedAt DateTime?

  /// Admin comp: a lifetime grant (`compedUntil` null) or a time-boxed one —
  /// also how support extends a trial, and how the whole existing cohort is
  /// grandfathered before the paywall is switched on.
  compActive            Boolean?  @default(false)
  compReason            String?
  compedUntil           DateTime?
  compedByAdminId       String?   @db.ObjectId
  compedAt              DateTime?
  /// Admin hard revoke (ToS breach, chargeback). Outranks everything, including
  /// a live purchase — see the resolver's precedence.
  accessRevoked         Boolean?  @default(false)
  revokedReason         String?
  revokedAt             DateTime?
  // Admin gate for the feedback board (moderation, status changes). We gate on
  // this column, NOT an email allowlist: Sign in with Apple + Private Relay puts
  // an @privaterelay.appleid.com email in the JWT, so an email allowlist would
  // silently break. OPTIONAL on purpose: on MongoDB `@default` is a create-time
  // default only and `db push` never rewrites existing docs — a REQUIRED field
  // would make Prisma throw when reading any legacy user (locking out login).
  // Optional → legacy docs read back as null, and every check is `!user?.isAdmin`.
  isAdmin               Boolean?  @default(false)
  // Account moderation state, set from the admin console: "active" | "suspended".
  // Optional so documents written before this field existed still read cleanly.
  status                String?   @default("active")
  // --- Onboarding funnel (denormalized cache; OnboardingProfile is the truth) ---
  // BOTH OPTIONAL on purpose: on MongoDB `@default` is a create-time default only
  // and `db push` never rewrites existing docs — a REQUIRED field would make
  // Prisma throw when reading any legacy user. Optional → legacy docs read null.
  //
  // The name the user asked to be called, mirrored from OnboardingProfile so
  // GET /api/me can render it without a join (the client previously derived a
  // name from the email local-part). Written only by POST /api/onboarding.
  displayName           String?
  // Cheap funnel gating on the boot path: mobile already calls GET /api/me, so
  // "resume the funnel or not" must be answerable from that one response. null on
  // legacy accounts means "no server-side record" — clients must OR this with the
  // local flag / an active entitlement rather than re-running the funnel.
  onboardingCompletedAt DateTime?

  /// When the address was proved. `emailVerified` is the boolean the code
  /// branches on; this is for support and audit — "verified, but when?" is the
  /// first question asked about a suspicious account.
  emailVerifiedAt       DateTime?
  /// Stamped on every password change, and compared against a JWT's `iat` in
  /// requireAuth so a reset actually ENDS other sessions.
  ///
  /// Tokens here are stateless with a 30-day life and no revocation list, so
  /// without this a password reset does not log an attacker out — which is the
  /// single thing a person resetting a password is trying to do. Null on every
  /// account that predates this column, and the comparison must treat null as
  /// "no cutoff", or the deploy signs the entire user base out at once.
  passwordChangedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices            Device[]
  focusInvites       FocusInvite[]
  focusEvents        FocusEvent[]
  snapshot           SyncSnapshot?
  authProviders      AuthProvider[]
  featureRequests    FeatureRequest[]   @relation("UserFeatureRequests")
  votes              Vote[]             @relation("UserVotes")
  liveSessions       LiveSession[]
  protectionLock     ProtectionLock?
  pushTokens         PushToken[]
  onboarding         OnboardingProfile?
  purchases          Purchase[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
}

// A focus session that is HAPPENING RIGHT NOW, reported by a client via
// `POST /api/sessions/heartbeat` roughly every 5 minutes while it runs (and once
// on start / on end). The admin console reads these to show live activity in
// near-real-time. One row per (user, device): a device has at most one live
// session, upserted on each beat and deleted when the session ends. A row whose
// `lastHeartbeatAt` is older than the staleness window is treated as ended
// (the client crashed / went offline without a clean stop).
model LiveSession {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stable client device id (e.g. "win-<MachineGuid>").
  deviceId        String
  // Client session id (the desktop's per-session id). A device runs UP TO TWO
  // sessions at once (a manual "Start Focus" + a scheduled one), so a device has
  // one LiveSession row PER session, not per device. Optional so rows written by
  // the earlier one-per-device version still read back (they expire quickly). The
  // row `id` is deterministic from (user, device, session).
  sessionId       String?
  deviceName      String?
  platform        String? // "windows" | "macos" | "android" | "ios" | "ipados"
  name            String // session title
  phase           String    @default("running") // "running" | "break"
  hardLock        Boolean   @default(false)
  totalSeconds    Int       @default(0)
  remainSeconds   Int       @default(0)
  killedTotal     Int       @default(0)
  appsCount       Int       @default(0)
  sitesCount      Int       @default(0)
  originEventId   String? // schedule block id that auto-started it, if any
  startedAt       DateTime
  endsAt          DateTime? // predicted end (now + remaining)
  // Admin "force end" signal: set true from the console; the client stops the
  // session (overriding a hard lock) on its next heartbeat and deletes the row.
  forceEnd        Boolean   @default(false)
  lastHeartbeatAt DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([userId, deviceId])
  @@index([lastHeartbeatAt])
}

// Social / password login identities linked to a User (1-N). Lets one account
// be reached via Apple, Google, or email+password interchangeably.
model AuthProvider {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // "apple" | "google" | "password"
  providerUid String // Apple `sub`, Google `sub`, or the user id for password
  createdAt   DateTime @default(now())

  @@unique([provider, providerUid])
  @@index([userId])
}

model Device {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  platform      String // OS: "windows" | "macos" | "android" | "ios" | "ipados"
  kind          String? // form factor: "desktop" | "phone" | "tablet"
  // The real cross-platform identity key, REQUIRED at the API boundary (see
  // validation/schemas.ts). Nullable only because pre-refactor rows exist that
  // never carried one — they are leftovers to clean up, not a supported case.
  // Convergence under concurrent registration comes from the `uniq_user_deviceId`
  // partial index plus the duplicate-key retry in routes/devices.ts.
  deviceId      String?
  model         String?
  osVersion     String?
  appVersion    String?
  pushToken     String? // APNs token (mobile push)
  // The one-active-phone binding (status / boundAt / supersededAt / lastRebindAt
  // / idfv) was removed: changing devices is not something WeLockIn polices, and
  // the cooldown it powered was bypassable with a DELETE + POST anyway. Existing
  // documents may still carry those keys; Prisma simply ignores them.
  attestKeyId   String? // App Attest key id (base64)
  attestPubKey  Bytes? //  App Attest public key (raw/DER), set at key registration
  attestCounter Int?     @default(0) // strictly-increasing App Attest assertion counter (anti-replay)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  // NOTE: (userId, name) is intentionally NON-unique — two iPhones both report
  // "iPhone" to unentitled apps, and every Mac used to report "Mac". Uniqueness is
  // (userId, deviceId), enforced by the partial unique index `uniq_user_deviceId`
  // created in scripts/device-migrate.ts.
  @@index([userId, name])
  @@index([userId])
  @@index([userId, deviceId])
}

// An invitation for ONE device to join a focus session started on another.
//
// This is the SOURCE OF TRUTH for cross-device focus, not the push notification.
// A push is only an accelerator for phones; desktops have no push transport at
// all (Expo is mobile-only), so every device polls this collection. One shared
// state, two transports — otherwise the phone and the desktop paths drift apart.
model FocusInvite {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Client session id of the ORIGIN session, so replays converge on one row.
  sessionId      String
  fromDeviceId   String
  fromDeviceName String?
  // The client deviceId this invite is addressed to.
  toDeviceId     String

  sessionName String?
  hardLock    Boolean  @default(false)
  // Absolute end of the origin session. A device that wakes up late joins for
  // the REMAINING time; an invite whose endsAt has passed is simply ignored.
  endsAt      DateTime

  status      String    @default("pending") // "pending" | "accepted" | "declined"
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  // The polling query: one device asking for what is waiting for it.
  @@index([userId, toDeviceId, status])
  // Idempotent creation: re-posting the same session for the same target must
  // not stack invites.
  @@index([sessionId, toDeviceId])
}

model Break {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  deviceId        String?
  clientBreakId   String?
  durationSeconds Int
  startedAt       DateTime @default(now())
  endsAt          DateTime
  quarantined     Boolean? @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, startedAt])
  @@index([userId, clientBreakId])
}

model SyncSnapshot {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @unique @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocklists Json
  sessions   Json
  // Weekly recurring schedule plan (client-defined SchedEvent[]). Optional so
  // snapshots created before this field existed still read back cleanly, and so
  // a client that never sends schedules (e.g. mobile) doesn't wipe them.
  schedules  Json?
  revision   Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model FocusEvent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String?
  name           String
  startedAt      DateTime
  endedAt        DateTime
  plannedSeconds Int
  completed      Boolean
  hardLock       Boolean
  killedTotal    Int      @default(0)
  // Mobile / multi-platform additions (all optional → PC events unaffected).
  platform       String? // "ios" | "ipados" | "macos" | "windows"
  clientEventId  String? // idempotency key for offline replay
  // Optional during the first rollout so pre-existing Mongo documents that do
  // not contain the field remain readable. New writes always provide a boolean.
  emergencyUsed  Boolean? @default(false)
  // Anti-abuse (Part D): set true when the reporting deviceId does not resolve to
  // the user's active phone (kept for audit, excluded from stats/streaks/quotas).
  // Optional so legacy events read back cleanly; null/false both count.
  quarantined    Boolean? @default(false)
  createdAt      DateTime @default(now())

  // No nullable unique index is needed: events carrying a clientEventId use a
  // deterministic Mongo _id, making concurrent replay atomic at the DB level.
  @@index([userId])
  @@index([userId, startedAt])
  @@index([userId, clientEventId])
}

// ---------------------------------------------------------------------------
// Feedback / feature-request board (public, auth-gated, UGC — Apple 1.2 compliant
// via report + delete + auto-hide). All models below are NEW → purely additive.
// ---------------------------------------------------------------------------

enum FeatureRequestStatus {
  open
  planned
  in_progress
  done
  declined
}

model FeatureRequest {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  authorId        String               @db.ObjectId
  author          User                 @relation("UserFeatureRequests", fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  body            String               @default("")
  status          FeatureRequestStatus @default(open)
  voteCount       Int                  @default(0) // denormalized; recomputed as count(votes) on every vote write
  commentCount    Int                  @default(0) // reserved — comment routes are out of MVP scope
  hidden          Boolean              @default(false) // moderation: hidden rows never appear in GET /
  reportCount     Int                  @default(0)
  // Idempotency key for create retries (offline replay of the same POST). Every
  // FeatureRequest is created with one; the compound unique below makes a retried
  // POST return the existing row instead of inserting a duplicate. This is a NEW
  // model so every row has a non-null value — the @@unique is safe on `db push`.
  clientRequestId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  votes   Vote[]
  reports FeatureReport[]

  @@unique([authorId, clientRequestId])
  @@index([authorId])
  @@index([status, voteCount])
  @@index([createdAt])
}

model Vote {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  featureRequestId String         @db.ObjectId
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  userId           String         @db.ObjectId
  user             User           @relation("UserVotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  // One vote per user per request. Idempotency of add/remove is enforced in the
  // route (catch P2002 on add, deleteMany on remove) so the client never sees a
  // 409/500 on a double-tap.
  @@unique([featureRequestId, userId])
  @@index([userId])
}

model FeatureReport {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  featureRequestId String         @db.ObjectId
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  reporterId       String         @db.ObjectId
  reason           String
  createdAt        DateTime       @default(now())

  @@unique([featureRequestId, reporterId]) // one report per user per post
  @@index([featureRequestId])
}

// ---------------------------------------------------------------------------
// Addiction protection: a GLOBAL curated blocklist (admin-managed) + per-user
// lock state (partner OTP / dated). NEW → purely additive.
// ---------------------------------------------------------------------------

// One entry (a site or app) in the global curated addiction-protection list.
// Seeded from the app's bundled JSON, then admin-managed via the console; clients
// fetch the active set on launch (GET /api/addiction-protection). Collection is
// named "protection" in Mongo.
model ProtectionEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String // "explicit" | "gambling" | ...
  kind      String // "site" | "app"
  value     String // normalized domain (host-only) or app id / exe name
  label     String? // display name
  platform  String?  @default("all") // "all" | "windows" | "macos" | "android" | "ios"
  active    Boolean  @default(true) // soft-disable without deleting
  source    String   @default("admin") // "seed" | "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value]) // dedup + idempotent upsert
  @@index([category, active])
  @@map("protection")
}

// Per-user addiction-protection lock. `method` = "partner" (unlock needs a
// one-time code emailed to the partner via Resend) or "date" (no unlock before
// `lockedUntil`). The OTP is stored so the admin console can display it and
// support/override an unlock (a friction code, not a credential).
model ProtectionLock {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @unique @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  active         Boolean   @default(false)
  method         String    @default("partner") // "partner" | "date"
  categories     String[] // enabled categories, e.g. ["explicit","gambling"]
  partnerContact String? // partner email the OTP is sent to
  otp            String? // current one-time code (partner method)
  otpSentAt      DateTime?
  // Failed unlock attempts against the CURRENT otp. Capped so a user can't brute-
  // force the 6-digit code: past the cap the otp is invalidated (a new one must be
  // requested, re-involving the partner). Reset on every (re)send.
  otpAttempts    Int?      @default(0)
  lockedUntil    DateTime? // date method: no unlock before this
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("protection_locks")
}

// ---------------------------------------------------------------------------
// Push notifications: one row per push token owned by a user's device. NEW →
// purely additive. `@unique(token)` makes registration idempotent AND gives the
// receipt worker a natural key to prune tokens the Expo Push service reports as
// DeviceNotRegistered. This is the foundation (P0) of the notification system.
// ---------------------------------------------------------------------------
model PushToken {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The client deviceId this token belongs to (links to a Device row). Optional so
  // a token can be stored even before/without a registered Device row.
  deviceId       String?
  token          String    @unique // e.g. "ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]"
  platform       String? // "ios" | "ipados" | "android"
  tokenType      String    @default("expo") // "expo" | "apns" | "fcm"
  valid          Boolean   @default(true)
  disabledReason String? // set by the receipt worker, e.g. "DeviceNotRegistered"
  appVersion     String?
  failureCount   Int       @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, valid])
  @@map("push_tokens")
}

// One row per push sent to one device — the audit log + inbox source + receipt
// reconciliation target. No User back-relation (raw userId, like Break) → cleaned
// up explicitly in me.ts. NEW → purely additive (P1).
model NotificationDelivery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId // recipient (null for a token with no known owner)
  token     String? // the push token targeted
  title     String
  body      String
  data      Json?
  channel   String   @default("push")
  status    String   @default("queued") // "queued" | "sent" | "error" | "invalid"
  ticketId  String? // Expo ticket id (for later receipt polling)
  error     String? // Expo/transport error message when status="error"
  source    String   @default("admin") // "admin" | "rule:<event>"
  // Best-effort idempotency key (from a rule's dedupeKeyTemplate) so concurrent
  // first-beats of the same session don't double-notify the same user.
  dedupeKey String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([dedupeKey])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Data-driven notification engine (P2). A TEMPLATE is the content (title/body/data
// with {{variables}}); a RULE binds an event to a template + audience + throttle,
// entirely in data — so new notifications are added from the admin with NO code.
// ---------------------------------------------------------------------------
model NotificationTemplate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique // e.g. "pc_locked"
  title     String // supports {{variables}}
  body      String // supports {{variables}}
  data      Json? // deep-link payload template; string values support {{variables}}
  category  String   @default("system") // "cross_device" | "lifecycle" | "system" | "marketing" | "security"
  sound     String?  @default("default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model NotificationRule {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  event             String // "session.started"
  // Match against the event context, e.g. { "platform": { "$in": ["windows","macos"] } }.
  condition         Json     @default("{}")
  templateKey       String
  // e.g. { "mode": "sameUserOtherDevices", "excludeOrigin": true }.
  audience          Json
  dedupeKeyTemplate String? // e.g. "pc_locked:{{sessionId}}"
  enabled           Boolean  @default(true)
  priority          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([event, enabled])
  @@map("notification_rules")
}

model OnboardingProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which funnel produced the ORIGINAL record. Immutable after the first
  // submission — it is the audit anchor for the answers below.
  funnelVersion          String
  // Idempotency key, minted client-side once per completed funnel run (and once
  // per later edit). Stored for REPLAY CLASSIFICATION only, never indexed: the
  // natural key of a 1:1 resource is userId, and Prisma creates plain non-sparse
  // unique indexes on MongoDB, so a nullable `@unique` would E11000 on the second
  // row that omits the value.
  clientSubmissionId     String
  // The name the user asked to be called (screen 1). Mirrored onto User.
  displayName            String?
  // "16_17" | "18_24" | "25_34" | "35_44" | "45_plus". The declared age is
  // validated then REDUCED to this band; the exact integer is never persisted
  // (data minimisation — a non-null band is also the evidence the gate ran).
  ageBand                String
  // Stable answer slugs, NOT indices (option lists churn; indices silently
  // corrupt on insertion) and NOT Prisma enums (a new option would need a
  // `db push` on the live cluster). Unknown slugs are stored verbatim.
  profileSlug            String? // e.g. "founder_or_freelancer"
  goalSlug               String? // e.g. "focus_better"
  // SELF-DECLARED distractions from a fixed list — NOT the FamilyControls
  // selection (those tokens are opaque and never leave the device). Order is the
  // user's tap order, because screen 12 renders the first three.
  distractingAppSlugs    String[]  @default([])
  // Self-REPORTED hours/day from the gauge, 0..12 (0 is a legal, reachable
  // value). Named so it can never be mistaken for measured Screen Time data.
  selfReportedDailyHours Int
  // Audit echo of the derived numbers the client actually DISPLAYED. Never read
  // for logic: hoursPerYear / yearsLost / reclaimDaysPerYear are always
  // recomputed server-side from selfReportedDailyHours (src/lib/onboarding.ts).
  clientProjection       Json?
  locale                 String? // BCP-47, e.g. "fr-FR"
  appVersion             String?
  platform               String? // "ios" | "ipados" | "macos" | "android" | "windows"
  // The stable client deviceId as a plain string (like Break/FocusEvent), NOT a
  // relation: the funnel POSTs before the device is registered.
  deviceId               String?
  // Client-reported funnel start. Immutable after the first submission.
  startedAt              DateTime?
  // SERVER clock at the first successful submission. Immutable.
  completedAt            DateTime
  // Bumped on every merge (a new clientSubmissionId); an exact replay writes nothing.
  revision               Int       @default(0)
  // Soft abuse guard: rolling-hour window for MUTATING submissions, counted on
  // the row itself so no extra collection is needed. Check-then-act race accepted.
  writeWindowStartedAt   DateTime?
  writeWindowCount       Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// A completed payment. ONE row per storefront transaction, whatever the
// storefront: iOS goes through Adapty because Apple requires store IAP, while the
// macOS and Windows builds ship outside the App Store and are sold through Lemon
// Squeezy. Both land here, told apart by `provider`, so entitlement stays one
// rule instead of one rule per shop.
model Purchase {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String // "lemonsqueezy" | "adapty"
  store       String // "lemonsqueezy" | "app_store" | "play_store"
  productId   String
  /// The storefront's own id for this transaction, stable across replay and
  /// refund. Unique WITH the provider, never alone: two shops number their orders
  /// independently, so an Adapty transaction id and a Lemon Squeezy order id can
  /// collide — and a collision would hand one customer's licence to another.
  externalId  String
  priceUsd    Float?
  purchasedAt DateTime
  isRefunded  Boolean   @default(false)
  refundedAt  DateTime?
  /// Kept for support and for replaying a delivery we mishandled.
  rawEvent    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, externalId])
  @@index([userId])
}

// Every webhook delivery we accepted, recorded before it is acted on so a payload
// we mishandle is still on disk to be replayed once the handling is fixed.
model WebhookEvent {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  provider    String
  /// Dedupe key. Unique per provider so two shops cannot shadow each other.
  eventId     String
  type        String
  payload     Json
  /// "processing" while the work is in flight, then "processed" | "skipped" |
  /// "failed". A retry that finds a row still "processing" or "failed" re-runs the
  /// work: treating mere existence as done loses the purchase of anyone whose
  /// first delivery died halfway.
  status      String    @default("processing")
  error       String?
  attempts    Int       @default(1)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

/// The anti-abuse ledger: one free trial per MACHINE, forever.
///
/// This model exists because the previous answer — stamping `User.trialEndsAt`
/// at registration — tied the trial to an account, and an account is free,
/// unverified and unlimited. A new email was a new fortnight, and `DELETE
/// /api/me` freed the old email so even the SAME address could go round again.
///
/// So the natural key is the machine, and the row deliberately OUTLIVES the
/// account: `firstUserId` is nulled when a user is deleted, the claim is not.
/// Deleting your account and starting over lands on the same expired window.
///
/// `deviceIdHash` is `HMAC-SHA256(TRIAL_LEDGER_PEPPER, deviceId)` — keyed, not a
/// plain digest, and the raw device id is never stored here. The pepper lives in
/// the environment and never in Mongo, so a database copy alone cannot be walked
/// back to the machines it describes. Rotating the pepper orphans every claim
/// and re-opens the farm; treat it as permanent.
model TrialClaim {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// THE key, and GLOBALLY unique — not unique per user, which would be no
  /// constraint at all. It is also the concurrency lock: two simultaneous claims
  /// for one machine collide here rather than racing check-then-act.
  deviceIdHash String  @unique
  /// Secondary correlation for iOS (`identifierForVendor`), where the client
  /// device id is resettable. Null on macOS, whose id is hardware-derived.
  idfvHash     String?
  /// The iOS leg: HMAC of the App Store `originalTransactionId` of the Tier-0
  /// trial IAP. A non-consumable stays in the Apple ID's purchase history and
  /// Apple replays the ORIGINAL transaction on every restore, so this is the one
  /// anchor here that survives a factory reset — which the Keychain device id
  /// does not. Null on macOS and on any claim made before a purchase was posted.
  ///
  /// INDEXED, NOT `@unique`, on purpose. A MongoDB unique index treats a missing
  /// field as null and admits only ONE such document, so making this unique
  /// would reject the second macOS claim ever written. The hard concurrency lock
  /// stays on `deviceIdHash`; the Apple leg is enforced by an explicit lookup in
  /// POST /api/purchases before the create.
  appleOriginalTxHash String?

  /// Who claimed it first. NULLED on account deletion — the claim survives, the
  /// link to a deleted person does not.
  firstUserId String?   @db.ObjectId
  /// Snapshot of TRIAL_DAYS when the claim was made, so changing the product's
  /// trial length never retroactively lengthens or shortens someone's window.
  trialDays   Int?
  startedAt   DateTime?
  /// Server wall clock, stamped ONCE. Immutable: nothing in the system may move
  /// a trial's end, which is the entire point of writing it down.
  endsAt      DateTime?
  status      String?   @default("active") // "active"|"expired"|"converted"

  /// Abuse signals, recorded but never acted on automatically — they exist so a
  /// human reviewing a suspicious account has something to look at.
  ///
  /// `hardwareBacked: false` means the Mac could not read IOPlatformUUID and the
  /// client fell back to a file it can delete. That is a resettable identity, so
  /// such a claim is flagged and given a short window rather than the full one.
  hardwareBacked Boolean? @default(true)
  flagged        Boolean? @default(false)
  /// Difference between the client's clock and ours at claim time. A machine set
  /// years into the future is not evidence of anything on its own, since the
  /// server owns the countdown — but a pattern of it is.
  clockSkewMs    Int?
  skewStrikes    Int?     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signals DeviceSignal[]

  @@index([idfvHash])
  @@index([firstUserId])
  @@index([appleOriginalTxHash])
}

/// One hardware signal seen on a trial claim: a MachineGuid, a volume serial or
/// a MAC address, each keyed-hashed like `deviceIdHash`.
///
/// Rows ACCUMULATE, and that is the design. The owner asked to key the "one
/// account per machine" rule on the MAC address; a MAC alone cannot carry that
/// weight — Windows randomises Wi-Fi MACs by default, every VPN and hypervisor
/// invents more, and a USB dock's MAC walks between laptops. Keyed on it alone,
/// a legitimate user who unplugs a dock looks like a new machine while a
/// fraudster spoofing one looks like an old one, which is exactly backwards.
///
/// So identity is a COMPOSITE, and matching needs either the MachineGuid (which
/// survives a dock, a Wi-Fi toggle and a reboot) or the volume serial together
/// with at least one MAC (which survives a registry reset). A MAC on its own is
/// recorded and never decides. Because rows accumulate rather than replace,
/// plugging the dock back in ADDS a signal instead of losing one.
model DeviceSignal {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  claimId String     @db.ObjectId
  claim   TrialClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  /// "mguid" | "vol" | "mac" — never mixed, so a MAC can never be compared
  /// against a volume serial that happens to hash to the same value.
  kind String
  /// HMAC-SHA256(TRIAL_LEDGER_PEPPER, "fp:v1:<kind>:<raw>"). Same pepper as the
  /// ledger on purpose: these hashes describe the same machines and live in the
  /// same trust boundary, so a second key would add ceremony and no security.
  hash String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  /// The upsert key, so re-seeing a signal touches `lastSeenAt` instead of
  /// growing the table on every request.
  @@unique([claimId, kind, hash])
  /// The lookup: "which claim, if any, has ever shown this signal?"
  @@index([kind, hash])
}

/// A 6-digit code proving someone can read the address they signed up with.
///
/// HASHED at rest, unlike the addiction-protection partner OTP, which is stored
/// in plaintext and shown to admins on purpose. That one is social friction;
/// this one decides whether an account may be used at all, so it is a
/// credential. See lib/tokens.ts.
model EmailVerification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The address the code was SENT TO, frozen at issue time. Without this, a
  /// code minted for the old address would still verify the new one after an
  /// email change — proving the user can read an inbox they no longer claim.
  email  String

  codeHash String
  /// Enforced in application code on every read, NOT by this column alone:
  /// Prisma cannot declare a MongoDB TTL index, and Mongo's TTL monitor is
  /// best-effort and roughly once a minute anyway. The TTL index built by
  /// `scripts/auth-migrate.ts` is housekeeping; the query is the guarantee.
  expiresAt DateTime
  /// Incremented ATOMICALLY ({ increment: 1 }). A read-modify-write lets N
  /// parallel guesses share one count, which is the whole budget in one shot.
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// A single-use, short-lived password-reset token, hashed at rest.
///
/// Only the hash is stored, so a database copy cannot be replayed into anyone's
/// account. The raw token exists in exactly one place: the link in the email.
model PasswordReset {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  email  String

  /// REQUIRED and unique — never nullable. On MongoDB, Prisma builds
  /// non-sparse unique indexes, so a second null row would collide (see the
  /// note on SyncSnapshot). It is also the concurrency lock that makes
  /// single-use real: two simultaneous consumptions of one token contend here
  /// instead of both passing a check-then-act.
  tokenHash String @unique

  expiresAt  DateTime
  consumedAt DateTime?
  /// For abuse review only. Never shown to the user, never used to decide.
  requestIp  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// A rolling-window counter for auth rate limits.
///
/// Backed by the database rather than process memory because this API runs on
/// Vercel: every instance would hold its own counter, so an in-memory limiter
/// caps nothing and merely looks like it does.
model AuthThrottle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// "<action>:<subject>", e.g. "reset-request:ip:1.2.3.4". Unique because it
  /// is the upsert key.
  key             String   @unique
  windowStartedAt DateTime
  count           Int      @default(1)

  updatedAt DateTime @updatedAt

  @@index([windowStartedAt])
}

/// Every admin action that changes what someone may do, with a reason.
///
/// Comps and revocations are the two ways a human can override the resolver, and
/// an override nobody can explain later is indistinguishable from a mistake — so
/// the reason is required at the route and the before/after are kept.
model AdminAuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId      String   @db.ObjectId
  actorEmail   String?
  action       String // "comp"|"revoke"|"extend_trial"|"reset_trial"|"grandfather"
  targetUserId String?  @db.ObjectId
  reason       String?
  before       Json?
  after        Json?
  meta         Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

/// A published desktop installer. The public manifest endpoint
/// (GET /api/updates/...) reads exactly one of these; the admin console writes
/// them. Rows are never edited in place once live — a burned version number
/// stays burned, which is what makes rollback safe.
model Release {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  channel String @default("stable")
  target  String @default("windows") // Tauri {{target}}
  arch    String @default("x86_64") // Tauri {{arch}}
  version String // "0.2.0" — semver, no leading v
  /// Zero-padded form of `version` so Mongo can order releases without semver
  /// logic. See lib/semver.ts `toSortKey`.
  versionKey String
  notes      String  @default("")
  pubDate    DateTime
  /// Absolute URL of the artifact the UPDATER downloads. Immutable per version.
  url String
  /// Absolute URL of the artifact a HUMAN downloads, when it is a different
  /// file. Optional, and absent means "same as `url`" — on Windows both are the
  /// one `setup.exe`, so nothing existing has to change.
  ///
  /// macOS is why this exists. A release there produces two artifacts that are
  /// NOT interchangeable: `.app.tar.gz`, which is the only shape Tauri's updater
  /// can verify and unpack, and `.dmg`, which is the only shape a person can
  /// install from. Hand the tarball to a browser and it expands to a bare `.app`
  /// in ~/Downloads, macOS runs it translocated from a read-only temporary path,
  /// and the app cannot arm its enforcement from a location that vanishes when
  /// it quits. The visitor installs a blocker that blocks nothing, and is told
  /// nothing.
  installerUrl String?
  /// Verbatim contents of the .sig Tauri emits next to the installer. The client
  /// verifies the download against the pubkey compiled into it, so this value
  /// being wrong means "no client will install", never "an unsigned install".
  sha256    String?
  signature String
  sizeBytes Int?

  /// draft → live → (paused | rolled_back | superseded)
  status String @default("draft")
  /// 0..100. `stable` clients are only offered a release at 100.
  rolloutPercent Int @default(0)
  /// 0..99, rotates which buckets go first so the same slice of the population
  /// isn't the guinea pig for every single release.
  rolloutOffset Int @default(0)

  publishedAt DateTime?
  pausedAt    DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([channel, target, arch, version])
  @@index([channel, target, arch, status, versionKey])
  @@map("releases")
}
