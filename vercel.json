{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notification-receipts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/billing-tasks",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/checkout-abandoned",
      "schedule": "0 */6 * * *"
    }
  ]
}
